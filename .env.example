# Copy to .env and fill in values. Never commit .env.

# Required for Papers RAG chat (OpenAI chat completions).
OPENAI_API_KEY=sk-...

# Optional overrides (defaults match RagConfig).
# OPENAI_MODEL=gpt-4o-mini
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_STRATEGY=llamaindex
# CHROMA_DIR=.data/indexes/llamaindex
# CHROMA_COLLECTION=papers
# PAPERS_DIR=assets/pdf/papers
# CHUNK_SIZE=1024
# CHUNK_OVERLAP=128
# SIMILARITY_TOP_K=5
